# Copy this file to a private environment file. Never commit real keys.
# full profile reads .env by default. For another file, use:
# AFTERSALES_ENV_FILE=/tmp/aftersales.env docker compose --env-file /tmp/aftersales.env --profile full up -d --wait
# Optional Compose setting: path to the container environment file.
# AFTERSALES_ENV_FILE=/tmp/aftersales.env

# Required: OpenAI-compatible chat endpoint, model name, and API key.
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=
# Required for DeepSeek: adaptive or disabled. Other providers may leave it empty.
CHAT_THINKING=adaptive

# Required: embedding and reranking keys. These models use SiliconFlow.
EMBED_API_KEY=
RERANK_API_KEY=
# Optional: override the default provider endpoints.
EMBED_BASE_URL=https://api.siliconflow.cn/v1
RERANK_BASE_URL=https://api.siliconflow.cn/v1

# Required for host Python commands. full profile overrides these three values
# with mysql:3306, milvus-standalone:19530, and /app/config/tools.docker.json.
DATABASE_URL=mysql+asyncmy://aftersales:aftersales@127.0.0.1:3307/aftersales?charset=utf8mb4
MILVUS_URI=http://127.0.0.1:19530
# Optional: local tool policy; empty also uses config/tools.json.
TOOL_POLICY_PATH=config/tools.json

# Optional: context window and output/input token limits.
MODEL_CONTEXT_WINDOW=128000
MAX_OUTPUT_TOKENS=8192
MAX_USER_INPUT_TOKENS=1400
# Optional: maximum Agent steps, tool result budget, and reranker Top-K.
MAX_AGENT_STEPS=4
TOOL_RESULT_MAX_TOKENS=750
RERANK_TOP_K=10

# Optional: leave both keys empty to disable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# For full profile and a separately started local Langfuse, use
# http://host.docker.internal:3100. With the Langfuse Compose file merged,
# use http://langfuse-web:3000. Host Python commands use http://127.0.0.1:3100.
LANGFUSE_BASE_URL=

# Optional: inject a delay in seconds into the mock MCP tools (default 0).
MOCK_DELAY_SECONDS=0
